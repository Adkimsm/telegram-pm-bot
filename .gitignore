# ---------------------------------------------------------------------------
# Secrets — never commit these.
#
# BOT_TOKEN is the only real secret this project has, and every other secret
# (webhook token, session key, claim code) is HMAC-derived from it. Leaking it
# therefore compromises the bot, the admin console and the relay group at once.
# Production stores it via `wrangler secret put BOT_TOKEN`.
# ---------------------------------------------------------------------------
.dev.vars
.dev.vars.*
!.dev.vars.example

.env
.env.*
!.env.example

*.secret
secrets.json
credentials.json

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Cloudflare / Wrangler credentials
.cloudflare/
wrangler.toml.local
wrangler.*.local.jsonc

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/

# ---------------------------------------------------------------------------
# Build and runtime output
# ---------------------------------------------------------------------------
.wrangler/
.build/
dist/
out/
tests/.build/

# Local D1 / Durable Object state created by `wrangler dev`
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ---------------------------------------------------------------------------
# Logs and caches
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
